# Copie para .env; credenciais somente no servidor.
# Instância existente, banco dedicado autorizado; use a role de runtime documentada em docs/backend/operations.md.
DATABASE_URL="postgresql://minha_cozinha_app:SENHA@10.0.0.117:5432/minha_cozinha?schema=minha_cozinha"
# Opcional: conexão de migração com permissão DDL apenas no schema da aplicação.
# MIGRATION_DATABASE_URL="postgresql://minha_cozinha_migrator:SENHA@10.0.0.117:5432/minha_cozinha?schema=minha_cozinha"
IMAGE_STORAGE_DIR="./storage/images"
BACKUP_DIR="./backups"
# Origens separadas por vírgula para proxy reverso; não use curingas.
APP_ORIGINS="http://localhost:3000"
PORT=3000

# Logs do servidor: pretty (legível) ou json (coleta automatizada).
LOG_FORMAT=pretty
# Nível mínimo: info, warn ou error.
LOG_LEVEL=info

# IP privado do servidor Docker; padrão 127.0.0.1 não permite acesso por outros dispositivos.
LAN_BIND_IP=127.0.0.1
APP_PORT=3000
BACKUP_HOST_DIR=./backups

# Compatível com a major do PostgreSQL existente (somente ferramentas cliente).
PG_MAJOR=17
APP_IMAGE_TAG=local
